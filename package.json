{
  "name": "semantic-search-engine",
  "version": "1.0.0",
  "description": "Universal semantic search engine with pluggable sources, profile-based filtering, and action dispatching",
  "main": "src/server.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=src src/server.js",
    "test": "jest --forceExit",
    "test:coverage": "jest --forceExit --coverage",
    "test:smoke": "jest --config jest.smoke.config.js --no-coverage",
    "verify": "npm run lint && npm run test:coverage && npm run test:client",
    "lint": "eslint src/ __tests__/ scripts/",
    "lint:fix": "eslint src/ __tests__/ --fix",
    "format": "prettier --write \"src/**/*.js\" \"__tests__/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"__tests__/**/*.js\"",
    "test:client": "npm --prefix client run test"
  },
  "keywords": [
    "semantic-search",
    "embeddings",
    "nlp",
    "content-discovery"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@huggingface/transformers": "^4.2.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "groq-sdk": "^1.5.0",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "onnxruntime-node": "^1.27.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "eslint": "^10.8.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  }
}
